[Unit]
Description=LTX monitoring - ClickHouse data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaston
Group=gaston
WorkingDirectory=/srv/shared/LTX-Python
ExecStart=/srv/shared/.venv/bin/python src/main.py monitoring/datacollector
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
