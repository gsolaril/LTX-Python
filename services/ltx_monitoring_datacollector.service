[Unit]
Description=LTX monitoring - ClickHouse data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaston
Group=gaston
WorkingDirectory=~
ExecStart=/srv/shared/.venv/bin/ltx monitoring/datacollector
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
