[Unit]
Description=LTX data connector - Binance USDM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaston
Group=gaston
WorkingDirectory=~
ExecStart=/srv/shared/.venv/bin/python LTX-Python/src/main.py connectors/binanceusdm
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
