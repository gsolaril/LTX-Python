[Unit]
Description=LTX misc connector - Polymarket Gamma (Tokens)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaston
Group=gaston
WorkingDirectory=~
ExecStart=/srv/shared/.venv/bin/ltx connectors/polymarketgamma
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
